local function onCharacter(character: Model)
	stopFly(); destroyNoclipGroundLock()
	state.character = character
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
	local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root or not humanoid:IsA("Humanoid") or not root:IsA("BasePart") then return end
	state.humanoid = humanoid
	state.root = root
	state.defaultWalkSpeed = humanoid.WalkSpeed
	state.defaultJumpPower = humanoid.JumpPower
	humanoid.UseJumpPower = true
	humanoid.WalkSpeed = state.walkSpeed
	humanoid.JumpPower = state.jumpPower
	if state.noclipWanted then setNoclip(true) end
	connect(humanoid.Died, function() stopFly(); destroyNoclipGroundLock(); if state.freecam then stopFreecam() end end)
end

buildUI()
if player.Character then onCharacter(player.Character) end
