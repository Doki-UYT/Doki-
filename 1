connect(UserInputService.JumpRequest, function()
	local humanoid = state.humanoid
	if state.infJump and humanoid and not state.freecam then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

connect(UserInputService.InputBegan, function(input, processed)
	if processed then return end
	local key = input.KeyCode
	if state.freecam and camera and key == Enum.KeyCode.Space then
		if os.clock()-state.lastFreecamDash >= 0.5 then camera.CFrame += camera.CFrame.LookVector*100; state.lastFreecamDash=os.clock() end
		return
	end
	if key == Enum.KeyCode.W or key == Enum.KeyCode.Up then freecamInput.forward=1 end
	if key == Enum.KeyCode.S or key == Enum.KeyCode.Down then freecamInput.forward=-1 end
	if key == Enum.KeyCode.D or key == Enum.KeyCode.Right then freecamInput.right=1 end
	if key == Enum.KeyCode.A or key == Enum.KeyCode.Left then freecamInput.right=-1 end
	if key == Enum.KeyCode.E then freecamInput.up=1 end
	if key == Enum.KeyCode.Q then freecamInput.up=-1 end
end)
connect(UserInputService.InputEnded, function(input)
	local key=input.KeyCode
	if key==Enum.KeyCode.W or key==Enum.KeyCode.S or key==Enum.KeyCode.Up or key==Enum.KeyCode.Down then freecamInput.forward=0 end
	if key==Enum.KeyCode.A or key==Enum.KeyCode.D or key==Enum.KeyCode.Left or key==Enum.KeyCode.Right then freecamInput.right=0 end
	if key==Enum.KeyCode.Q or key==Enum.KeyCode.E then freecamInput.up=0 end
end)
connect(UserInputService.InputChanged, function(input, processed)
	if state.freecam and not processed and input.UserInputType == Enum.UserInputType.MouseMovement and camera then
		local delta = input.Delta
		-- Scriptable cameras do not receive Roblox's standard camera rotation, so rotate it here.
		camera.CFrame = camera.CFrame * CFrame.Angles(0, -delta.X * 0.0025, 0) * CFrame.Angles(-delta.Y * 0.0025, 0, 0)
	end
end)

local espElapsed = 0
local fpsFrames = 0
connect(RunService.Heartbeat, function(dt)
	if state.dead then return end
	-- Dynamic ground-lock only counters gravity while a close floor is detected. It avoids falling through floors but is not a full character-controller replacement.
	local antiGravity = noclip.antiGravity
	local root = state.root
	local character = state.character
	if state.noclipActive and antiGravity and root and character then
		local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={character}
		local hit=Workspace:Raycast(root.Position, Vector3.new(0,-4.5,0), params)
		-- Only hold the surface while standing still or descending.  Never apply
		-- the ground lock during upward movement, so jumps can pass through and
		-- land on higher platforms without a ceiling-like lock.
		antiGravity.Enabled = hit ~= nil and root.AssemblyLinearVelocity.Y <= 0
		if hit then antiGravity.Force=Vector3.new(0, root.AssemblyMass*Workspace.Gravity, 0) end
	end
	espElapsed += dt
	if state.esp and espElapsed >= 0.5 then
		espElapsed = 0
		updateESP()
	end
end)

connect(RunService.RenderStepped, function(dt)
	fpsFrames += 1
	camera = Workspace.CurrentCamera
	local root = state.root
	local humanoid = state.humanoid
	if state.flying and root and camera then
		local forward = (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
		forward += (UserInputService:IsKeyDown(Enum.KeyCode.Up) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.Down) and 1 or 0)
		local right = (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
		local vertical = (UserInputService:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0)
		local camCF = camera.CFrame
		local mobile = humanoid and humanoid.MoveDirection or Vector3.zero
		local mobileForward = mobile:Dot(camCF.LookVector)
		local mobileRight = mobile:Dot(camCF.RightVector)
		local direction = camCF.LookVector*(forward + mobileForward) + camCF.RightVector*(right + mobileRight) + Vector3.yAxis*vertical
		if direction.Magnitude > 0 then direction = direction.Unit end
		local velocity = fly.velocity
		local orientation = fly.orientation
		if velocity then velocity.VectorVelocity = direction * state.flySpeed end
		if orientation then orientation.CFrame = CFrame.lookAt(root.Position, root.Position + camCF.LookVector) end
	end
	if state.shiftLock and not state.freecam and root and camera and humanoid then
		humanoid.AutoRotate=false
		local look=Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z)
		if look.Magnitude>0 then root.CFrame=CFrame.lookAt(root.Position,root.Position+look) end
	elseif humanoid and not state.freecam then humanoid.AutoRotate=true end
	if state.freecam and camera then
		freecamCFrame = camera.CFrame
		local cf=camera.CFrame
		local mobile = humanoid and humanoid.MoveDirection or Vector3.zero
		local move=(cf.LookVector*(freecamInput.forward + mobile:Dot(cf.LookVector)) + cf.RightVector*(freecamInput.right + mobile:Dot(cf.RightVector)) + Vector3.yAxis*freecamInput.up)
		if move.Magnitude>0 then camera.CFrame += move.Unit*70*dt end
	end
end)

task.spawn(function()
	local last = os.clock()
	while not state.dead do
		task.wait(0.1)
		local now = os.clock()
		local elapsed = math.max(now - last, 0.0001)
		local fps = math.min(240, fpsFrames / elapsed)
		fpsFrames = 0
		last = now
		setText(ui.fps, string.format("fps: %.1f", fps))
	end
end)

local function cleanup()
	stopFly(); stopFreecam(); destroyNoclipGroundLock(); destroyESP()
	state.noclipWanted=false; state.noclipActive=false
	local humanoid = state.humanoid
	if humanoid then humanoid.WalkSpeed=state.defaultWalkSpeed; humanoid.JumpPower=state.defaultJumpPower; humanoid.AutoRotate=true end
	restoreCharacterCollision()
	Workspace.Gravity=STARTUP_GRAVITY
	if camera then camera.FieldOfView=STARTUP_FOV end
	player.CameraMaxZoomDistance=STARTUP_MAX_ZOOM
	for _, connection in ipairs(connections) do connection:Disconnect() end
	if ui.gui then ui.gui:Destroy() end
end

task.spawn(function()
    while not state.dead do
        task.wait(0.1)
    end

    cleanup()
end)
