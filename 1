local function connect(signal: RBXScriptSignal, callback: (...any) -> ())
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function setText(label: Instance?, text: string)
    if not label then
        return
    end

    if label:IsA("TextLabel") then
        label.Text = text
    elseif label:IsA("TextButton") then
        label.Text = text
    elseif label:IsA("TextBox") then
        label.Text = text
    end
end

local function clampNumber(value, minimum, maximum, fallback)
	value = tonumber(value)
	if not value then return fallback end
	return math.clamp(value, minimum, maximum)
end

local function getCharacterParts(): { BasePart }
	local character = state.character
	if not character then return {} end
	local parts: { BasePart } = {}
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then table.insert(parts, descendant) end
	end
	return parts
end

local function restoreCharacterCollision()
	for _, part in ipairs(getCharacterParts()) do
		part.CanCollide = part.Name ~= "HumanoidRootPart"
	end
	local root = state.root
	if root then root.CanCollide = false end -- normal characters normally use humanoid physics, not root collision
end

local function applyNoCollision(enabled)
	for _, part in ipairs(getCharacterParts()) do
		part.CanCollide = not enabled and part.Name ~= "HumanoidRootPart"
	end
	local root = state.root
	if root then root.CanCollide = false end
end

local function destroyNoclipGroundLock()
	local antiGravity = noclip.antiGravity
	local attachment = noclip.attachment
	if antiGravity then antiGravity:Destroy() end
	if attachment then attachment:Destroy() end
	noclip.antiGravity = nil
	noclip.attachment = nil
end

local function startNoclipGroundLock()
	destroyNoclipGroundLock()
	local root = state.root
	if not root then return end

	-- Keep local references non-optional while configuring the Instances.  The
	-- optional table fields are only for later cleanup after this function ends.
	local attachment: Attachment = Instance.new("Attachment")
	attachment.Name = "DokiGroundLockAttachment"
	attachment.Parent = root

	local antiGravity: VectorForce = Instance.new("VectorForce")
	antiGravity.Name = "DokiGroundLock"
	antiGravity.Attachment0 = attachment
	antiGravity.RelativeTo = Enum.ActuatorRelativeTo.World
	antiGravity.ApplyAtCenterOfMass = true
	antiGravity.Enabled = false
	antiGravity.Parent = root

	noclip.attachment = attachment
	noclip.antiGravity = antiGravity
end

-- Collision ownership is deliberately exclusive: Fly wins over Noclip.
local function setNoclip(active)
	state.noclipActive = active
	if active then
		applyNoCollision(true)
		startNoclipGroundLock()
	else
		destroyNoclipGroundLock()
		if not state.flying then restoreCharacterCollision() end
	end
	if ui.noclipButton then ui.noclipButton.Text = "Noclip: " .. (state.noclipWanted and "ON" or "OFF") end
end

local function destroyFlyConstraints()
	for _, object in pairs(fly) do
		if object then object:Destroy() end
	end
	fly = { attachment = nil, velocity = nil, orientation = nil }
end

local function stopFly()
	if not state.flying then return end
	state.flying = false
	destroyFlyConstraints()
	local humanoid = state.humanoid
	if humanoid then humanoid.PlatformStand = false end
	-- Required ordering: Fly off -> restore collision -> Noclip takes ownership if requested.
	restoreCharacterCollision()
	if state.noclipWanted then setNoclip(true) end
	if ui.flyButton then ui.flyButton.Text = "Fly: OFF" end
end

local function startFly()
	local root = state.root
	local humanoid = state.humanoid
	if state.flying or not root or not humanoid then return end
	-- Required ordering: Noclip off -> restore collision -> Fly manages collision.
	if state.noclipActive then setNoclip(false) end
	restoreCharacterCollision()
	state.flying = true
	applyNoCollision(true)
	humanoid.PlatformStand = true

	-- The references saved in fly are optional because cleanup clears them.
	-- Configure the newly-created constraints through non-optional locals first.
	local attachment: Attachment = Instance.new("Attachment")
	attachment.Name = "DokiFlyAttachment"
	attachment.Parent = root

	local velocity: LinearVelocity = Instance.new("LinearVelocity")
	velocity.Name = "DokiFlyVelocity"
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.MaxForce = 100000
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = root

	local orientation: AlignOrientation = Instance.new("AlignOrientation")
	orientation.Name = "DokiFlyOrientation"
	orientation.Attachment0 = attachment
	orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orientation.RigidityEnabled = true
	orientation.MaxTorque = 100000
	orientation.Parent = root

	fly.attachment = attachment
	fly.velocity = velocity
	fly.orientation = orientation
	if ui.flyButton then ui.flyButton.Text = "Fly: ON" end
end

local function setFly(enabled)
	if enabled then startFly() else stopFly() end
end

local function setWalkSpeed(value)
	state.walkSpeed = clampNumber(value, 0, 300, state.walkSpeed)
	local humanoid = state.humanoid
	if humanoid then humanoid.WalkSpeed = state.walkSpeed end
	setText(ui.walkBox, tostring(math.floor(state.walkSpeed + 0.5)))
end

local function setJumpPower(value)
	state.jumpPower = clampNumber(value, 0, 300, state.jumpPower)
	local humanoid = state.humanoid
	if humanoid then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = state.jumpPower
	end
	setText(ui.jumpBox, tostring(math.floor(state.jumpPower + 0.5)))
end

local function setFov(value)
	state.fov = math.floor(clampNumber(value, 1, 120, state.fov) + 0.5)
	camera = Workspace.CurrentCamera
	if camera then camera.FieldOfView = state.fov end
	setText(ui.fovBox, tostring(state.fov))
end

local function setGravity(value)
	state.gravity = clampNumber(value, -500, 1000, state.gravity)
	Workspace.Gravity = state.gravity
	setText(ui.gravityBox, tostring(math.floor(state.gravity + 0.5)))
end

local function destroyESP()
	for instance, highlight in pairs(espHighlights) do
		if highlight then highlight:Destroy() end
		local label = instance:FindFirstChild("DokiESPDistance")
		if label then label:Destroy() end
		espHighlights[instance] = nil
	end
end

local function addESP(target, color)
	if not target or espHighlights[target] then return end
	local highlight = Instance.new("Highlight")
	highlight.Name = "DokiESP"
	highlight.Adornee = target
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.FillTransparency = 0.65
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = target
	espHighlights[target] = highlight
	local part = target:IsA("Model") and (target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart) or (target:IsA("BasePart") and target)
	if part and part:IsA("BasePart") and state.root then
		local billboard = Instance.new("BillboardGui"); billboard.Name = "DokiESPDistance"; billboard.Adornee = part; billboard.Size = UDim2.fromOffset(100, 20); billboard.StudsOffset = Vector3.new(0, 3, 0); billboard.AlwaysOnTop = true; billboard.Parent = target
		local text = Instance.new("TextLabel"); text.BackgroundTransparency = 1; text.Size = UDim2.fromScale(1, 1); text.TextColor3 = color; text.TextStrokeTransparency = 0; text.Font = Enum.Font.GothamBold; text.TextSize = 12; text.Text = string.format("%.0f M", (part.Position - state.root.Position).Magnitude); text.Parent = billboard
	end
end

local function updateESP()
	destroyESP()
	if not state.esp then return end
	if state.character then addESP(state.character, Color3.fromRGB(210, 210, 210)) end
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and other.Character then addESP(other.Character, BLUE) end
	end
	for _, model in ipairs(Workspace:GetDescendants()) do
		if model:IsA("Model") and model ~= state.character then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
			if humanoid and root and not Players:GetPlayerFromCharacter(model) then
				local moving = root.AssemblyLinearVelocity.Magnitude > 0.5
				addESP(model, moving and Color3.fromRGB(255, 75, 75) or Color3.fromRGB(80, 255, 110))
			end
		end
	end
	-- Mark non-NPC objects intentionally in Studio with CollectionService tag "DokiESPObject".
	for _, object in ipairs(CollectionService:GetTagged("DokiESPObject")) do addESP(object, Color3.fromRGB(160, 160, 160)) end
end

local function stopFreecam()
	if not state.freecam then return end
	state.freecam = false
	camera = Workspace.CurrentCamera
	if camera then
		camera.CameraType = savedCamera.cameraType or Enum.CameraType.Custom
		local subject = savedCamera.subject or state.humanoid
		if subject then camera.CameraSubject = subject end
		camera.FieldOfView = state.fov
	end
	local humanoid = state.humanoid
	if humanoid then humanoid.AutoRotate = true end
	if ui.freecamButton then ui.freecamButton.Text = "Freecam: OFF" end
end

local function startFreecam()
	if state.freecam then return end
	camera = Workspace.CurrentCamera
	if not camera then return end
	state.freecam = true
	savedCamera.cameraType, savedCamera.subject = camera.CameraType, camera.CameraSubject
	camera.CameraType = Enum.CameraType.Scriptable
	freecamCFrame = camera.CFrame
	local humanoid = state.humanoid
	if humanoid then humanoid.AutoRotate = false end
	if ui.freecamButton then ui.freecamButton.Text = "Freecam: ON" end
end

local function setFreecam(enabled)
	if enabled then startFreecam() else stopFreecam() end
end

